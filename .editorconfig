# J47 - editor settings
# https://editorconfig.org
#
# The line-ending rules here are not cosmetic:
#   * a CRLF .sh fails in Bash with "unexpected token $'do\r'"
#   * a CRLF .patch fails `git apply` with a corrupt-hunk error
#   * a BOM-less .ps1 containing non-ASCII is parsed as the system ANSI code
#     page by Windows PowerShell 5.1, which can corrupt it into a parse error
# Keep the three groups below in sync with scripts/repo/00_organize_repo.sh.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash,py,patch,diff}]
end_of_line = lf
charset = utf-8

[*.{ps1,cmd,bat,nsi}]
end_of_line = crlf

[*.{md,csv,txt,java}]
end_of_line = lf

# Generated by the build; never hand-edited.
[*.{jmod,jfr,exe,dll,lib,pdb,obj,class}]
insert_final_newline = unset
trim_trailing_whitespace = unset
