diff --git a/src/hotspot/os/windows/os_windows.cpp b/src/hotspot/os/windows/os_windows.cpp
index 72a365fde..2d0fd4281 100644
--- a/src/hotspot/os/windows/os_windows.cpp
+++ b/src/hotspot/os/windows/os_windows.cpp
@@ -3297,6 +3297,9 @@ size_t os::win32::large_page_init_decide_size() {
 
   if (!os::win32::request_lock_memory_privilege()) {
     WARN("JVM cannot use large page memory because it does not have enough privilege to lock pages in memory.");
+    // J47: always log once even for ergonomic defaults (was silent when FLAG_IS_DEFAULT).
+    log_warning(gc)("J47: SeLockMemoryPrivilege missing ([Lock Pages in Memory] not granted). "
+                    "Large pages disabled, continuing with regular pages.");
     return 0;
   }
 
@@ -3621,12 +3624,19 @@ char* os::pd_reserve_memory_special(size_t bytes, size_t alignment, size_t page_
 
   if (!is_aligned(bytes, page_size)) {
     // Fallback to small pages, Windows does not support mixed mappings.
+    // J47: warn on fallback (was silent nullptr).
+    log_warning(gc)("J47: Large pages reserve failed: size not aligned "
+                    "(bytes=" SIZE_FORMAT ", page=" SIZE_FORMAT "), falling back to regular pages.",
+                    bytes, page_size);
     return nullptr;
   }
 
   // Ensure GetLargePageMinimum() returns a valid positive value
   size_t large_page_min = GetLargePageMinimum();
   if (large_page_min <= 0) {
+    // J47: warn when OS reports no large-page support.
+    log_warning(gc)("J47: Large pages unavailable (GetLargePageMinimum()=0). "
+                    "Grant [Lock Pages in Memory] or disable UseLargePages. Falling back.");
     return nullptr;
   }
 
