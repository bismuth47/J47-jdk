diff --git a/src/hotspot/share/runtime/arguments.cpp b/src/hotspot/share/runtime/arguments.cpp
index 0076b9f0b..9e30ca479 100644
--- a/src/hotspot/share/runtime/arguments.cpp
+++ b/src/hotspot/share/runtime/arguments.cpp
@@ -3985,6 +3985,42 @@ jint Arguments::apply_ergo() {
   // Set compiler flags after GC is selected and GC specific
   // flags (LoopStripMiningIter) are set.
   CompilerConfig::ergo_initialize();
+  // J47-TP: ZGC-conditional ergonomics (throughput recovery, pause-neutral).
+  // All guarded by IS_DEFAULT so explicit -XX keeps precedence. Deltas are
+  // intentionally small: larger inline/unroll blows up nmethods and hurts
+  // i-cache, which directly lengthens the <1ms pause budget.
+  if (UseZGC) {
+    FLAG_SET_ERGO_IF_DEFAULT(UseSuperWord, true);
+    // J47-TP fix 3: never force MaxVectorSize. On AVX2-only CPUs (UseAVX=2)
+    // the value 64 is rejected by MaxVectorSizeConstraintFunc, which printed
+    // "MaxVectorSize must be at most 32 on this platform" on every start and
+    // left the flag clamped to 32 anyway. The auto default already selects the
+    // platform maximum (32 on AVX2, 64 on AVX-512/UseAVX=3), so leave it alone.
+    FLAG_SET_ERGO_IF_DEFAULT(InlineSmallCode, 2500);
+    FLAG_SET_ERGO_IF_DEFAULT(FreqInlineSize, 325);
+    FLAG_SET_ERGO_IF_DEFAULT(MaxInlineSize, 50);
+    FLAG_SET_ERGO_IF_DEFAULT(CICompilerCount, 4);
+    FLAG_SET_ERGO_IF_DEFAULT(ReservedCodeCacheSize, 512*M);
+    FLAG_SET_ERGO_IF_DEFAULT(AlwaysPreTouch, true);
+    // J47-TP fix 1: never touch UseLargePages / LargePageSizeInBytes here.
+    // os::init_before_ergo() -> os::large_page_init() (os.cpp:465-469) has
+    // already run at this point and early-returns while UseLargePages is still
+    // default-false (os_windows.cpp:3344-3347), leaving os::large_page_size()
+    // == 0. Forcing the flag on from ergonomics therefore made
+    // GCArguments::compute_heap_alignment() (gcArguments.cpp:82) call
+    // lcm(0, alignment), which divides by zero (globalDefinitions.cpp:383-392,
+    // INT_DIVIDE_BY_ZERO) and crashed every JVM start. Large pages must stay
+    // opt-in per run: -XX:+UseLargePages (needs SeLockMemoryPrivilege; ZGC then
+    // uses the OS-reported 2MB pages, EnableAllLargePageSizesForWindows=false
+    // keeps 1GB pages out).
+    // J47-TP fix 2: never force UseCountedLoopSafepoints / LoopStripMiningIter.
+    // ZArguments::initialize() already sets them as *default* values
+    // (true / 1000, zArguments.cpp:191-196). Setting them ergonomically made
+    // LoopStripMiningIterConstraintFunc (jvmFlagConstraintsCompiler.cpp:408-416)
+    // print a warning on every start and rewrite LoopStripMiningIter to 1,
+    // i.e. a safepoint poll on every counted-loop iteration instead of the
+    // intended strip mining.
+  }
 
   // Set bytecode rewriting flags
   set_bytecode_flags();
